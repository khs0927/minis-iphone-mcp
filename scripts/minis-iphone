#!/usr/bin/env python3
"""minis-iphone — fastest direct control channel to the iPhone/Minis bridge.

Talks JSON-RPC (Streamable HTTP) straight to the local bridge MCP server.
No CLI startup overhead: a full tool call takes ~10-40ms instead of ~12s.

  minis-iphone list                      # list all tool names
  minis-iphone tools                      # full tool schemas
  minis-iphone <tool> '{"arg":"val"}'    # call a tool
  minis-iphone shell 'ls -la'             # shorthand for iphone_shell
  minis-iphone native apple-device        # shorthand for iphone(tool=args)
"""
import json
import os
import sys
import urllib.error
import urllib.request

BRIDGE = os.environ.get("MINIS_BRIDGE_URL", "http://127.0.0.1:8900")
TOKEN_FILE = os.environ.get("MINIS_BRIDGE_TOKEN_FILE",
                            "/var/minis/shared/claude-bridge/token")


def _token():
    try:
        with open(TOKEN_FILE) as f:
            return f.read().strip()
    except Exception:
        return ""


def rpc(method, params=None, timeout=180):
    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method,
                       "params": params or {}}).encode()
    req = urllib.request.Request(
        BRIDGE + "/mcp", data=body, method="POST",
        headers={
            "Authorization": "Bearer " + _token(),
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
        })
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read().decode("utf-8", "replace")
    raw = raw.strip()
    if raw.startswith("event:") or raw.startswith("data:"):
        for line in raw.splitlines():
            if line.startswith("data:"):
                raw = line[5:].strip()
                break
    return json.loads(raw)


def unwrap(res):
    if "error" in res:
        return {"error": res["error"]}
    r = res.get("result", res)
    if isinstance(r, dict) and "content" in r:
        texts = [c.get("text", "") for c in r.get("content", [])
                 if c.get("type") == "text"]
        joined = "\n".join(t for t in texts if t)
        try:
            return json.loads(joined)
        except Exception:
            return joined or r
    return r


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 1
    cmd = args[0]

    if cmd in ("list", "tools"):
        res = rpc("tools/list")
        tools = res.get("result", {}).get("tools", [])
        if cmd == "list":
            for t in tools:
                print(t["name"])
        else:
            print(json.dumps(tools, ensure_ascii=False, indent=2))
        return 0

    if cmd == "shell":
        payload = {"tool": "iphone_shell", "args": {"command": args[1] if len(args) > 1 else ""}}
    elif cmd == "native":
        payload = {"tool": "iphone", "args": {"tool": args[1], "args": json.loads(args[2]) if len(args) > 2 else {}}}
    else:
        payload = {"tool": cmd, "args": json.loads(args[1]) if len(args) > 1 else {}}

    res = rpc("tools/call", {"name": payload["tool"], "arguments": payload["args"]})
    out = unwrap(res)
    print(json.dumps(out, ensure_ascii=False, indent=2) if isinstance(out, (dict, list)) else out)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except urllib.error.HTTPError as e:
        print("HTTP %s: %s" % (e.code, e.read().decode("utf-8", "replace")[:500]),
              file=sys.stderr)
        sys.exit(3)
    except Exception as e:
        print("ERR %s: %s" % (type(e).__name__, e), file=sys.stderr)
        sys.exit(4)
