#!/bin/sh
# Keepalive for the Minis iPhone MCP bridge (v3, robust).
# - Restarts the private bridge on port 8900 if /health fails.
# - Restarts the ngrok tunnel (single instance) if the public URL fails.
# - No tunnel restart self-suicide (removed minis-tunnel restart that killed itself).
set -u
STATE_DIR=${MINIS_BRIDGE_STATE_DIR:-/var/minis/shared/claude-bridge}
PIDF=$STATE_DIR/keepalive.pid
LOG=$STATE_DIR/keepalive.log
BRIDGE_PORT=8900
MARK=MINIS_KEEPALIVE_LOOP

loop_pids() {
  for p in /proc/[0-9]*; do
    [ -r "$p/cmdline" ] || continue
    c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null) || continue
    case "$c" in
      *"$MARK"*) echo "${p#/proc/}" ;;
    esac
  done
}

alive() { [ -n "$(loop_pids)" ]; }

# NOTE: kill_ngrok is intentionally NOT used from the keepalive loop because
# its pattern also matches this loop's own cmdline (self-kill).  Use
# `minis-ngrok stop` instead when a manual kill is needed.

case "$1" in
  start)
    if alive; then echo "keepalive already running (pid $(loop_pids | tr '\n' ' '))"; exit 0; fi
    cd "$STATE_DIR" 2>/dev/null || cd /tmp
    nohup sh -c 'while true; do sh /usr/local/bin/minis-keepalive-body; sleep 20; done # MINIS_KEEPALIVE_LOOP' >> "$LOG" 2>&1 &
    echo $! > $PIDF
    sleep 1
    echo "keepalive started (pid $(cat $PIDF))" ;;
  stop)
    for pid in $(loop_pids); do kill "$pid" 2>/dev/null; done
    rm -f $PIDF
    sleep 1
    echo "keepalive stopped" ;;
  status)
    if alive; then echo "KEEPALIVE UP (pid $(loop_pids | tr '\n' ' '))"; else echo "KEEPALIVE DOWN"; fi
    minis-bridge status | head -2
    minis-ngrok status | head -3 ;;
  *) echo "usage: minis-keepalive {start|stop|status}"; exit 1 ;;
esac
